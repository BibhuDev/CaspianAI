# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL + pgvector Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threadgraph?schema=public"

# Redis Queue Connection
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# OpenAI Configuration (for Structured Outputs & 1536-dim embeddings)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Caspian SDK Configuration (Unified Email & Slack communication layer)
CASPIAN_API_KEY="your-caspian-api-key-here"
CASPIAN_BASE_URL="https://api.trycaspianai.com"

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret-here"
